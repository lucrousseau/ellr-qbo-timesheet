APP_NAME="Ellr QBO Timesheet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Set to true only in local development to allow public sign-up
ALLOW_REGISTRATION=true

# Promote the first administrator after registration (via tinker or SQL):
# User::where('email', 'admin@example.com')->update(['is_admin' => true]);

# Require verified emails before sign-in and protected routes (recommended in production)
REQUIRE_EMAIL_VERIFICATION=false

# Dev-only test accounts (seeded when APP_ENV=local and DEV_SEED_ENABLED=true)
# TENANT_* = sample SaaS client org; PLATFORM_* = Ellr operator (manages client orgs).
DEV_SEED_ENABLED=true
DEV_SEED_ORGANIZATION_NAME="Ellr Development"
DEV_SEED_ORGANIZATION_SLUG=ellr-dev
DEV_SEED_PLATFORM_ENABLED=true
DEV_SEED_PLATFORM_EMAIL=luc@ellr.ca
DEV_SEED_PLATFORM_PASSWORD=EllrDev!2026
DEV_SEED_PLATFORM_NAME="Luc Ellr"
DEV_SEED_TENANT_ADMIN_EMAIL=admin@ellr.local
DEV_SEED_TENANT_ADMIN_PASSWORD=EllrDev!2026
DEV_SEED_TENANT_ADMIN_NAME="Dev Admin"

# Base URL used in verification emails and password reset when no client is specified
# Password reset emails from admin use FRONTEND_ADMIN_URL; timesheet uses FRONTEND_TIMESHEET_URL
FRONTEND_AUTH_URL=http://localhost:5174

# Mail (required when REQUIRE_EMAIL_VERIFICATION=true or using password reset)
# MAIL_MAILER=smtp

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# SQLite local/Docker: WAL + busy timeout reduce lock errors when api and queue share the DB file
DB_SQLITE_BUSY_TIMEOUT=5000
DB_SQLITE_JOURNAL_MODE=wal
# Production checklist (see README Production + docs/siteground-shared-hosting.md):
# APP_ENV=production
# APP_DEBUG=false
# ALLOW_REGISTRATION=false
# REQUIRE_EMAIL_VERIFICATION=true
# LOG_LEVEL=info
# DB_CONNECTION=mysql (or pgsql)
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.timesheet.ellr.ca
# SANCTUM_STATEFUL_DOMAINS=admin.timesheet.ellr.ca,timesheet.ellr.ca
# TRUSTED_PROXIES=*
# Shared (SiteGround): CACHE_STORE=database, QUEUE_CONNECTION=database, QUEUE_SHARED_HOSTING_DRAIN=true
# Cloud/VPS: CACHE_STORE=redis, QUEUE_CONNECTION=redis, QUEUE_SHARED_HOSTING_DRAIN=false + Supervisor queue:work
# APP_URL=https://api.timesheet.ellr.ca
# FRONTEND_ADMIN_URL=https://admin.timesheet.ellr.ca
# FRONTEND_TIMESHEET_URL=https://timesheet.ellr.ca
# FRONTEND_AUTH_URL=https://timesheet.ellr.ca
# QUICKBOOKS_REDIRECT_URI=https://api.timesheet.ellr.ca/api/quickbooks/callback
# Deploy: docs/siteground-shared-hosting.md (GitHub Actions SSH/rsync)
# DB_PORT=3306
# DB_DATABASE=ellr
# DB_USERNAME=ellr
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true in production (requires HTTPS)
SESSION_ENCRYPT=false
SESSION_PATH=/
# Use parent domain in production (e.g. .votredomaine.com) for cross-subdomain cookies
SESSION_DOMAIN=null
# Set to true in production behind HTTPS
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Shared hosting (SiteGround): drain the queue from schedule:run every minute.
# Keep false on Cloud/VPS when a permanent `queue:work` worker is running.
QUEUE_SHARED_HOSTING_DRAIN=false
# QUEUE_SHARED_HOSTING_DRAIN_MAX_TIME=50
# QUEUE_SHARED_HOSTING_DRAIN_TRIES=3

# Behind SiteGround / CDN / TLS terminator set TRUSTED_PROXIES=* (or comma-separated IPs)
# TRUSTED_PROXIES=

# Use redis on Cloud/VPS with multiple app instances (OAuth state, token refresh locks).
# On SiteGround Shared prefer database (default below).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# QuickBooks Online (Intuit Developer Portal)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI="${APP_URL}/api/quickbooks/callback"
QUICKBOOKS_SCOPE=com.intuit.quickbooks.accounting
QUICKBOOKS_BASE_URL=development
# Omit Intuit error bodies from API responses (defaults to false)
QUICKBOOKS_EXPOSE_API_ERRORS=false
# Max rows per GET /api/time-activities query (paginate with start_position and max_results)
QUICKBOOKS_TIME_ACTIVITIES_MAX_RESULTS=100
# Progressive TxnDate windows for employee time-activity scans (days, comma-separated)
QUICKBOOKS_TIME_ACTIVITIES_LOOKBACK_STEPS=14,30,90
QUICKBOOKS_TIME_ACTIVITIES_LOOKBACK_DAYS=90
QUICKBOOKS_TIME_ACTIVITIES_SCAN_MAX_PAGES=10
# Shared cache TTL and MAXRESULTS for QBO list endpoints (employees, customers, projects, services)
# TTL 0 disables caching. Lazy picker opens use the cache; send GET ?refresh=1 to bypass.
QUICKBOOKS_LIST_CACHE_TTL_MINUTES=15
QUICKBOOKS_LIST_MAX_RESULTS=1000
QUICKBOOKS_LIST_SCAN_MAX_PAGES=10
# Maximum accumulated timer seconds before log (default 24 hours)
QUICKBOOKS_TIME_TRACKER_MAX_ACCUMULATED_SECONDS=86400
# Intuit webhook verifier token (Developer portal > Webhooks)
QUICKBOOKS_WEBHOOK_VERIFIER=
# Webhook ingress limits (signed payloads only; rejects before queueing)
QUICKBOOKS_WEBHOOK_MAX_PAYLOAD_BYTES=262144
QUICKBOOKS_WEBHOOK_MAX_NOTIFICATIONS=50
QUICKBOOKS_WEBHOOK_MAX_ENTITIES_PER_NOTIFICATION=100
# Scheduled realm-wide snapshot reconcile (cron expression; default hourly)
QUICKBOOKS_TIME_ACTIVITIES_RECONCILE_ENABLED=true
QUICKBOOKS_TIME_ACTIVITIES_RECONCILE_CRON="0 * * * *"
# Skip scheduled reconcile when a realm was synced via webhook or reconcile within this many hours
QUICKBOOKS_TIME_ACTIVITIES_RECONCILE_SKIP_HOURS=1
# Seconds to wait before pushing approved entries so same-day/service siblings can coalesce
QUICKBOOKS_TIME_ENTRY_SYNC_GROUP_DELAY_SECONDS=15
# Unique job lock window (seconds) for a sync group key while a push is queued or running
QUICKBOOKS_TIME_ENTRY_SYNC_GROUP_UNIQUE_FOR=120
# Hard-delete soft-deleted snapshots older than this many days (0 disables pruning)
QUICKBOOKS_SNAPSHOT_SOFT_DELETE_RETENTION_DAYS=90
# Chunk size for realm purge and snapshot prune jobs (large tenants)
QUICKBOOKS_SNAPSHOT_PURGE_CHUNK_SIZE=1000

# Failed queue job retention before scheduled prune (hours; 0 disables pruning)
QUEUE_FAILED_JOBS_RETENTION_HOURS=168

# Frontend URLs (CORS / Sanctum)
FRONTEND_ADMIN_URL=http://localhost:5173
FRONTEND_TIMESHEET_URL=http://localhost:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174
