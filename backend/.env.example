APP_NAME="Ellr QBO Timesheet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Set to true only in local development to allow public sign-up
ALLOW_REGISTRATION=true

# Promote the first administrator after registration (via tinker or SQL):
# User::where('email', 'admin@example.com')->update(['is_admin' => true]);

# Require verified emails before sign-in and protected routes (recommended in production)
REQUIRE_EMAIL_VERIFICATION=false

# Base URL used in verification and password reset emails (defaults to timesheet app)
FRONTEND_AUTH_URL=http://localhost:5174

# Mail (required when REQUIRE_EMAIL_VERIFICATION=true or using password reset)
# MAIL_MAILER=smtp

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Docker Compose overrides these with MySQL (see docker-compose.yml)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true in production (requires HTTPS)
SESSION_ENCRYPT=false
SESSION_PATH=/
# Use parent domain in production (e.g. .votredomaine.com) for cross-subdomain cookies
SESSION_DOMAIN=null
# Set to true in production behind HTTPS
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use redis in production when running multiple app instances (OAuth state, token refresh locks)
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# QuickBooks Online (Intuit Developer Portal)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI="${APP_URL}/api/quickbooks/callback"
QUICKBOOKS_SCOPE=com.intuit.quickbooks.accounting
QUICKBOOKS_BASE_URL=development
# Omit Intuit error bodies from API responses (defaults to false)
QUICKBOOKS_EXPOSE_API_ERRORS=false
# Max rows per GET /api/time-activities query (paginate with start_position and max_results)
QUICKBOOKS_TIME_ACTIVITIES_MAX_RESULTS=100
# Probe QuickBooks for an extra row to set meta.truncated accurately (set false to skip the extra query)
QUICKBOOKS_TIME_ACTIVITIES_PROBE_TRUNCATED=true

# Frontend URLs (CORS / Sanctum)
FRONTEND_ADMIN_URL=http://localhost:5173
FRONTEND_TIMESHEET_URL=http://localhost:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174
