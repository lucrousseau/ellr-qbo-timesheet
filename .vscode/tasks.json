{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "qa",
      "type": "npm",
      "script": "qa",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "dev:api",
      "type": "npm",
      "script": "dev:api",
      "isBackground": true,
      "problemMatcher": {
        "owner": "laravel-serve",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Server running on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dev:admin",
      "type": "npm",
      "script": "dev:admin",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite-dev",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:\\s+http"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dev:timesheet",
      "type": "npm",
      "script": "dev:timesheet",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite-dev",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:\\s+http"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
