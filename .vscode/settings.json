{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.organizeImports": "explicit"
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "[php]": {
    "editor.defaultFormatter": "open-southeners.laravel-pint",
    "editor.formatOnSave": true
  },

  "laravel-pint.enable": true,
  "laravel-pint.executablePath": "${workspaceFolder}/backend/vendor/bin/pint",
  "laravel-pint.configPath": "${workspaceFolder}/backend/pint.json",

  "intelephense.files.maxSize": 5000000,
  "intelephense.format.enable": false,

  "phpSniffer.autoDetect": false,
  "phpSniffer.executablesFolder": "scripts",
  "phpSniffer.standard": "backend/phpcs.xml",
  "phpSniffer.run": "onSave",
  "phpSniffer.fixOnSave": false,
  "phpSniffer.workingDirectory": "workspaceRoot",
  "phpSniffer.logLevel": "error",
  "phpSniffer.showOutputOnError": true,

  "[typescript]": {
    "editor.formatOnSave": false
  },
  "[typescriptreact]": {
    "editor.formatOnSave": false
  },

  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,

  "oxc.enable.oxlint": true,
  "oxc.enable.oxfmt": false,
  "oxc.path.oxlint": "${workspaceFolder}/node_modules/.bin/oxlint",
  "oxc.disableNestedConfig": false,
  "oxc.lint.run": "onSave",

  "files.associations": {
    "*.mdc": "markdown"
  }
}
