# Docker Compose variables (copy to docker/.env)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ellr
MYSQL_USER=ellr
MYSQL_PASSWORD=secret

# Host port for MySQL (bound to 127.0.0.1 only). Change if 3306 is already in use locally.
MYSQL_PORT=3306

# Optional: override published app ports when 8000/5173/5174 are taken
# API_PORT=8000
# ADMIN_PORT=5173
# TIMESHEET_PORT=5174
