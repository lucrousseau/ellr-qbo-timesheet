{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run precommit)",
      "Bash(npm run qa)",
      "Bash(npm run qa:finance)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(docker/.env)",
      "Write(.env)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(docker/.env)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(docker/.env)",
      "Read(**/*.pem)",
      "Read(**/*_sg_deploy)",
      "Read(backend/storage/*.key)",
      "Read(backend/auth.json)"
    ]
  }
}
